<Window x:Class="TinyHero.OperationsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TinyHero 운영 센터"
        Width="490"
        Height="700"
        MinWidth="440"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="TinyHero" FontSize="13" FontWeight="SemiBold" Foreground="#6366F1" />
                <TextBlock Text="운영 센터" Margin="0,2,0,0" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="로컬 운영 서비스를 관리합니다." Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border x:Name="overallStatusBadge" HorizontalAlignment="Right" Background="#FEE4E2" CornerRadius="13" Padding="11,6">
                    <TextBlock x:Name="overallStatusText" Text="OFFLINE" Foreground="#B42318" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Button x:Name="refreshButton" Click="OnRefreshClicked" Background="#E9EAFE" Foreground="#3730A3" Padding="12,7" Margin="0,9,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="refreshIcon" Text="↻" FontSize="16" FontWeight="SemiBold" Margin="0,-1,7,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="refreshButtonText" Text="새로고침" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.07" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="서비스 상태" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="lastUpdatedText" Text="상태 확인 중" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="11" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="jenkinsIndicator" Width="11" Height="11" Fill="#98A2B3" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="Jenkins" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="127.0.0.1:8081" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                        <TextBlock x:Name="jenkinsStatusText" Grid.Column="2" Text="확인 중" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="jenkinsToggleButton" Grid.Column="4" Tag="JENKINS" Content="확인 중" Click="OnServiceToggleClicked" Padding="8,6" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="11" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="contentIndicator" Width="11" Height="11" Fill="#98A2B3" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="콘텐츠 서버" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="127.0.0.1:8082" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                        <TextBlock x:Name="contentStatusText" Grid.Column="2" Text="확인 중" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="contentToggleButton" Grid.Column="4" Tag="CONTENT" Content="확인 중" Click="OnServiceToggleClicked" Padding="8,6" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="6" Background="#F8FAFC" CornerRadius="11" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="portalIndicator" Width="11" Height="11" Fill="#98A2B3" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="운영 포털" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><TextBlock Text="127.0.0.1:8090" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                        <TextBlock x:Name="portalStatusText" Grid.Column="2" Text="확인 중" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="portalToggleButton" Grid.Column="4" Tag="PORTAL" Content="확인 중" Click="OnServiceToggleClicked" Padding="8,6" FontSize="11" />
                    </Grid>
                </Border>

                <Border Grid.Row="8" Background="#F8FAFC" CornerRadius="9" Padding="12,10">
                    <TextBlock x:Name="messageText" Text="시작 또는 종료 버튼으로 모든 로컬 서비스를 관리할 수 있습니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="startButton" Grid.Column="0" Click="OnStartClicked" Background="#182230" MinHeight="56" Padding="18,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="M 8,5 L 8,19 L 19,12 Z" Width="18" Height="18" Fill="White" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="서비스 시작" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="stopButton" Grid.Column="2" Click="OnStopClicked" Background="White" Foreground="#344054" BorderBrush="#D0D5DD" BorderThickness="1" MinHeight="56" Padding="18,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Rectangle Width="13" Height="13" Fill="#D92D20" RadiusX="2" RadiusY="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="서비스 종료" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="운영 포털 열기" Click="OnOpenPortalClicked" Background="#EEF2F6" Foreground="#344054" Padding="12,8" FontSize="12" />
                <Button Grid.Column="2" Content="Jenkins 열기" Click="OnOpenJenkinsClicked" Background="#EEF2F6" Foreground="#344054" Padding="12,8" FontSize="12" />
            </Grid>
        </Grid>
    </Grid>
</Window>

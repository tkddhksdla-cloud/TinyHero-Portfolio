  m_Script: {fileID: 11500000, guid: ef8659acd34e0354aa8df88c142b2c0d, type: 3}
  m_Name: QUEST_GRAHAM_002(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::TinyHero.Quest.CQuestDefinition
  questId: QUEST_GRAHAM_002
  questName: "\uC131\uC7A5\uC744 \uC704\uD55C \uCCAB \uAC78\uC74C"
  description: "\uCD0C\uC7A5\uC5D0\uAC8C \uC131\uC7A5\uC744 \uC704\uD55C \uAC00\uB974\uCE68\uC744
    \uBC1B\uC790."
  questType: 0
  giverNpcId: NPC_0001
  completerNpcId: NPC_0001
  useAcceptDialogue: 1
  acceptDialoguePreset:
    presetName: Preset
    dialogueLineList:
    - "\uADF8\uB798, \uC790\uB124\uC778\uAC00?\n\uBB34\uC2A8 \uC77C\uC778\uAC00?"
    - "\uC131\uC7A5\uC774\uB77C..\n\uC624\uB79C\uB9CC\uC5D0 \uC790\uB124\uC640 \uAC19\uC740
      \uC5F4\uC815\uC801\uC778 \uB208\uBE5B\uC744 \uBCF4\uB294\uAD70.."
    - "\uC88B\uB124.\n\uBA3C\uC800, \uC774 \uC55E \uC232\uC73C\uB85C \uAC00\uC11C
      \uBAAC\uC2A4\uD130\uB97C \uBA87 \uB9C8\uB9AC \uCC98\uCE58\uD55C \uD6C4, \uC804\uB9AC\uD488\uC744
      \uAC00\uC838\uC624\uAC8C."
    - "\uC131\uC7A5\uC5D4 \uC2E4\uC804\uACBD\uD5D8\uC774 \uAC00\uC7A5 \uC911\uC694\uD55C
      \uBC95.\n\uAC14\uB2E4\uC624\uAC8C."
  useCompleteDialogue: 1
  completeDialoguePreset:
    presetName: Preset
    dialogueLineList:
    - "\uC654\uB294\uAC00?\n\uC218\uACE0\uD588\uB124."
    - "\uC5B4\uB5A4\uAC00, \uC2E4\uC81C\uB85C \uBAAC\uC2A4\uD130\uB97C \uC0C1\uB300\uD55C\uB2E4\uB294
      \uAC74 \uB9CC\uB9CC\uCE58 \uC54A\uC558\uC744\uD14C\uC9C0.\n\uD6C8\uB828\uC6A9
      \uBC00\uC9DA\uC778\uD615\uC73C\uB85C \uC5F0\uC2B5\uD558\uB358 \uAC83\uACFC\uB294
      \uB610 \uB2E4\uB978 \uB290\uB08C\uC774\uC600\uC744\uAC8C\uC57C."
    - "\uC55E\uC73C\uB85C \uC815\uC9C4\uD558\uAC8C.\n\uC5F0\uC2B5\uACFC \uC2E4\uC804\uB9CC\uC774
      \uC790\uB124\uB97C \uB354 \uB192\uC740 \uACF3\uC73C\uB85C \uC131\uC7A5\uC2DC\uCF1C\uC904\uD14C\uB2C8."

  completeDialoguePreset:
    presetName: Preset
    dialogueLineList:
    - "\uD638\uC624 \uADF8\uB798, \uC774 \uD5A5\uAE30\uC57C."
    - "\uC815\uB9D0 \uACE0\uB9D9\uB124."
    - "\uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uAC8C."

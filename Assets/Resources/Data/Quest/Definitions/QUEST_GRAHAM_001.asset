  acceptDialoguePreset:
    presetName: Preset
    dialogueLineList:
    - "\uC7A1\uC544\uB3C4 \uC7A1\uC544\uB3C4 \uB05D\uC774 \uC5C6\uAD70.."
    - "\uC624, \uADF8\uB798 \uC790\uB124\uC778\uAC00?\n\uD639\uC2DC \uB9C8\uC744\uC744
      \uC704\uD574 \uBD80\uD0C1\uC744 \uC880 \uB4E4\uC5B4\uC904 \uC218 \uC788\uACA0\uB098?"
    - "\uC694\uC0C8 \uB9C8\uC744 \uC8FC\uBCC0\uC5D0 \uB3CC\uC544\uB2E4\uB2C8\uB294
      \uBAAC\uC2A4\uD130 \uB54C\uBB38\uC77C\uC138.\n\uC7A1\uC544\uB3C4 \uC7A1\uC544\uB3C4
      \uB05D\uC774 \uC5C6\uB2E4\uB124.."
    - "\uADF8 \uB188\uB4E4 \uC880 \uCC98\uCE58\uD574\uC8FC\uAC8C.\n\uC790\uB124\uB9CC
      \uBBFF\uACA0\uB124."

  sourceExcelAssetPath: Assets/RawData/Excel/Text/TextTableData.xlsx
  rowList:
  - textKey: KEY_TEXT_UI_COMMON_CONFIRM
    krText: "\uD655\uC778"
    enText: KEY_TEXT_UI_COMMON_CONFIRM
  - textKey: KEY_TEXT_UI_COMMON_CANCEL
    krText: "\uCDE8\uC18C"
    enText: KEY_TEXT_UI_COMMON_CANCEL
  - textKey: KEY_TEXT_UI_COMMON_CLOSE
    krText: "\uB2EB\uAE30"
    enText: KEY_TEXT_UI_COMMON_CLOSE
  - textKey: KEY_TEXT_UI_SAVE_COMPLETE
    krText: "\uC800\uC7A5\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    enText: KEY_TEXT_UI_SAVE_COMPLETE
  - textKey: KEY_TEXT_UI_SAVE_FAILED
    krText: "\uC800\uC7A5\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4."
    enText: KEY_TEXT_UI_SAVE_FAILED
  - textKey: KEY_TEXT_MAP_LOADING_DATA
    krText: "\uB9F5 \uB370\uC774\uD130\uB97C \uBD88\uB7EC\uC624\uB294 \uC911..."
    enText: KEY_TEXT_MAP_LOADING_DATA
  - textKey: KEY_TEXT_MAP_LOADING_COMPLETE
    krText: "\uB85C\uB529 \uC644\uB8CC"
    enText: KEY_TEXT_MAP_LOADING_COMPLETE
  - textKey: KEY_TEXT_ITEM_CONSUMABLE_CUBE_ITEM_NAME
    krText: "\uBBF8\uC2A4\uD2F1 \uD050\uBE0C"
    enText: KEY_TEXT_ITEM_CONSUMABLE_CUBE_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_CONSUMABLE_CUBE_DESCRIPTION
    krText: "\uC2E0\uBE44\uD55C \uD798\uC774 \uAE43\uB4E0 \uD050\uBE0C.\n\uC544\uC774\uD15C\uC758
      \uC7A0\uC7AC\uB2A5\uB825\uC744 \uC77C\uAE68\uC6CC\uC900\uB2E4\uACE0 \uC54C\uB824\uC838
      \uC788\uB2E4."
    enText: KEY_TEXT_ITEM_CONSUMABLE_CUBE_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_CONSUMABLE_SKILLBOOK_SHADOW_ITEM_NAME
    krText: "\uC100\uB3C4\uC6B0 \uD30C\uD2B8\uB108 \uC2A4\uD0AC\uBD81"
    enText: KEY_TEXT_ITEM_CONSUMABLE_SKILLBOOK_SHADOW_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_CONSUMABLE_SKILLBOOK_SHADOW_DESCRIPTION
    krText: "\uC100\uB3C4\uC6B0 \uD30C\uD2B8\uB108\uB97C \uBC30\uC6B8 \uC218 \uC788\uB294
      \uC2A4\uD0AC\uBD81\uC774\uB2E4."
    enText: KEY_TEXT_ITEM_CONSUMABLE_SKILLBOOK_SHADOW_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_CURRENCY_GOLD_ITEM_NAME
    krText: "\uACE8\uB4DC"
    enText: KEY_TEXT_ITEM_CURRENCY_GOLD_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_CURRENCY_GOLD_DESCRIPTION
    krText: "\uBC18\uC9DD\uAC70\uB9AC\uB294 \uC7AC\uD654\uC774\uB2E4.\n\uC5B4\uB51C\uAC00\uB4E0
      \uACF5\uC6A9\uC7AC\uD654\uB85C \uCDE8\uAE09\uB41C\uB2E4."
    enText: KEY_TEXT_ITEM_CURRENCY_GOLD_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_BRONZE_SWORD_ITEM_NAME
    krText: "\uBE0C\uB860\uC988 \uC18C\uB4DC"
    enText: KEY_TEXT_ITEM_EQUIPMENT_BRONZE_SWORD_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_BRONZE_SWORD_DESCRIPTION
    krText: "\uC5EC\uAE30\uC800\uAE30\uC11C \uD754\uD558\uAC8C \uBCFC \uC218 \uC788\uB294
      \uAC80\uC774\uB2E4.\n\uB300\uCDA9 \uC4F8\uB9CC\uD574\uBCF4\uC778\uB2E4."
    enText: KEY_TEXT_ITEM_EQUIPMENT_BRONZE_SWORD_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_ANGEL_KNIG_ITEM_NAME
    krText: "\uC5D4\uC824\uB098\uC774\uD2B8 \uD5EC\uBA67"
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_ANGEL_KNIG_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_ANGEL_KNIG_DESCRIPTION
    krText: "\uCC9C\uC0C1\uC758 \uAE30\uC0AC\uB2E8\uC7A5\uC774 \uCC29\uC6A9\uD588\uB2E4\uACE0
      \uC54C\uB824\uC9C4 \uC7A5\uBE44 \uC911 \uD558\uB098.\n\uBCF4\uACE0 \uC788\uAE30\uB9CC
      \uD574\uB3C4 \uC2E0\uC131\uD55C \uD798\uC774 \uB290\uAEF4\uC9C0\uB294 \uB4EF
      \uD558\uB2E4."
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_ANGEL_KNIG_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_DREX_ITEM_NAME
    krText: "\uB4DC\uB809\uC2A4\uC758 \uD22C\uAD6C"
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_DREX_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_DREX_DESCRIPTION
    krText: "\uB4DC\uB809\uC2A4\uAC00 \uD56D\uC0C1 \uCC29\uC6A9 \uC911\uC778 \uD22C\uAD6C\uC774\uB2E4.\n\uB611\uAC19\uC774
      \uC0DD\uAE34 \uD22C\uAD6C\uAC00 \uC5EC\uB7EC\uAC1C \uC788\uC74C\uC774 \uD2C0\uB9BC\uC5C6\uB2E4."
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_DREX_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_GOLD_KNIGH_ITEM_NAME
    krText: "\uACE8\uB4DC\uB098\uC774\uD2B8 \uD5EC\uBA67"
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_GOLD_KNIGH_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_HELMET_GOLD_KNIGH_DESCRIPTION
    krText: "\uAE08\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294 \uAE30\uC0AC\uC758 \uD22C\uAD6C\uC774\uB2E4.\n\uD574\uAC00
      \uBE44\uCD94\uBA74 \uB208\uC774 \uB108\uBB34 \uC544\uD508 \uAC83 \uAC19\uAE30\uB3C4..?"
    enText: KEY_TEXT_ITEM_EQUIPMENT_HELMET_GOLD_KNIGH_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_ANGEL_KNIGH_ITEM_NAME
    krText: "\uC5D4\uC824\uB098\uC774\uD2B8 \uC18C\uB4DC"
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_ANGEL_KNIGH_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_ANGEL_KNIGH_DESCRIPTION
    krText: "\uCC9C\uC0C1\uC758 \uAE30\uC0AC\uB2E8\uC7A5\uC774 \uCC29\uC6A9\uD588\uB2E4\uACE0
      \uC54C\uB824\uC9C4 \uC7A5\uBE44 \uC911 \uD558\uB098.\n\uBCF4\uACE0 \uC788\uAE30\uB9CC
      \uD574\uB3C4 \uC2E0\uC131\uD55C \uD798\uC774 \uB290\uAEF4\uC9C0\uB294 \uB4EF
      \uD558\uB2E4."
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_ANGEL_KNIGH_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_GOLD_KNIGHT_ITEM_NAME
    krText: "\uACE8\uB4DC\uB098\uC774\uD2B8 \uC18C\uB4DC"
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_GOLD_KNIGHT_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_GOLD_KNIGHT_DESCRIPTION
    krText: "\uAE08\uBE5B\uC73C\uB85C \uBE5B\uB098\uB294 \uAE30\uC0AC\uC758 \uAC80\uC774\uB2E4.\n\uD574\uAC00
      \uBE44\uCD94\uBA74 \uB208\uC774 \uB108\uBB34 \uC544\uD508 \uAC83 \uAC19\uAE30\uB3C4..?"
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_GOLD_KNIGHT_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_IGNITION_ITEM_NAME
    krText: "\uC774\uADF8\uB2C8\uC158 \uC18C\uB4DC"
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_IGNITION_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_EQUIPMENT_SWORD_IGNITION_DESCRIPTION
    krText: "\uBD88\uAF43\uC758 \uD798\uC774 \uAE43\uB4E0 \uAC80\uC774\uB2E4.\n\uC8FC\uC704\uC5D0
      \uB450\uAE30\uB9CC \uD574\uB3C4 \uB728\uAC70\uC6B4 \uC5F4\uAE30\uAC00 \uB290\uAEF4\uC9C4\uB2E4."
    enText: KEY_TEXT_ITEM_EQUIPMENT_SWORD_IGNITION_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_MATERIAL_HONEY_JELLY_ITEM_NAME
    krText: "\uD5C8\uB2C8\uC824\uB9AC"
    enText: KEY_TEXT_ITEM_MATERIAL_HONEY_JELLY_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_MATERIAL_HONEY_JELLY_DESCRIPTION
    krText: "\uB2EC\uCF64\uD55C \uD5A5\uC774 \uB098\uB294 \uD5C8\uB2C8 \uC824\uB9AC\uB2E4."
    enText: KEY_TEXT_ITEM_MATERIAL_HONEY_JELLY_DESCRIPTION
  - textKey: KEY_TEXT_ITEM_MATERIAL_TURTLE_SNAIL_WATER_ITEM_NAME
    krText: "\uAC70\uBD81 \uB2EC\uD33D\uC774\uC758 \uC810\uC561"
    enText: KEY_TEXT_ITEM_MATERIAL_TURTLE_SNAIL_WATER_ITEM_NAME
  - textKey: KEY_TEXT_ITEM_MATERIAL_TURTLE_SNAIL_WATER_DESCRIPTION
    krText: "\uB048\uC801\uB048\uC801\uD55C \uC810\uC561\uC774\uB2E4."
    enText: KEY_TEXT_ITEM_MATERIAL_TURTLE_SNAIL_WATER_DESCRIPTION
  - textKey: KEY_TEXT_QUEST_DREX_001_QUEST_NAME
    krText: "\uC78A\uC9C0 \uBABB\uD55C \uD5A5\uAE30"
    enText: KEY_TEXT_QUEST_DREX_001_QUEST_NAME
  - textKey: KEY_TEXT_QUEST_DREX_001_DESCRIPTION
    krText: "\uB4DC\uB809\uC2A4\uC5D0\uAC8C \uACE0\uBBFC\uC774 \uC788\uB294 \uAC83\uC77C\uAE4C?\n\uBB34\uC2A8
      \uC77C\uC778\uC9C0 \uBB3C\uC5B4\uBCF4\uC790."
    enText: KEY_TEXT_QUEST_DREX_001_DESCRIPTION
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_01
    krText: "\uBD84\uBA85 \uD558\uB098 \uCBE4\uC740 \uB5A8\uC5B4\uC838 \uC788\uC744\uD150\uB370..."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_01
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_02
    krText: "\uC624, \uC790\uB124\uC778\uAC00?\n\uB9C8\uCE68 \uC798 \uC654\uB124."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_02
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_03
    krText: "\uCD5C\uADFC\uC5D0 \uBB34\uC2A8 \uAE08\uC0C9 \uC824\uB9AC\uAC19\uC740
      \uAC83\uC744 \uBA39\uC5C8\uB294\uB370\n\uB108\uBB34 \uB9DB\uC788\uC5B4\uC11C
      \uC78A\uC744 \uC218\uAC00 \uC5C6\uB2E4\uB124.\n\uD5A5\uB3C4 \uC544\uC8FC \uC88B\uC558\uC9C0."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_03
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_04
    krText: "\uADFC\uCC98 \uBAAC\uC2A4\uD130\uB97C \uC7A1\uC73C\uBA74 \uB098\uC628\uB2E4\uB358\uB370,\n\uBA87
      \uAC1C\uB9CC \uAC00\uC838\uB2E4 \uC904 \uC218 \uC788\uACA0\uB098?"
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_04
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_01_02
    krText: "\uD638\uC624 \uADF8\uB798, \uC774 \uD5A5\uAE30\uC57C."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_01_02
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_02_02
    krText: "\uC815\uB9D0 \uACE0\uB9D9\uB124."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_02_02
  - textKey: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_03_02
    krText: "\uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uAC8C."
    enText: KEY_TEXT_QUEST_DREX_001_DIALOGUE_LINE_LIST_03_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_QUEST_NAME
    krText: "\uADF8\uB77C\uD568\uC758 \uACE0\uBBFC"
    enText: KEY_TEXT_QUEST_GRAHAM_001_QUEST_NAME
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DESCRIPTION
    krText: "\uADF8\uC758 \uC5BC\uAD74\uC5D4 \uADFC\uC2EC\uC774 \uAC00\uB4DD\uD558\uB2E4.\n\uBB34\uC2A8
      \uC77C\uC778\uC9C0 \uBB3C\uC5B4\uBCFC\uAE4C?"
    enText: KEY_TEXT_QUEST_GRAHAM_001_DESCRIPTION
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_01
    krText: "\uC7A1\uC544\uB3C4 \uC7A1\uC544\uB3C4 \uB05D\uC774 \uC5C6\uAD70.."
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_01
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_02
    krText: "\uC624, \uADF8\uB798 \uC790\uB124\uC778\uAC00?\n\uD639\uC2DC \uB9C8\uC744\uC744
      \uC704\uD574 \uBD80\uD0C1\uC744 \uC880 \uB4E4\uC5B4\uC904 \uC218 \uC788\uACA0\uB098?"
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_03
    krText: "\uC694\uC0C8 \uB9C8\uC744 \uC8FC\uBCC0\uC5D0 \uB3CC\uC544\uB2E4\uB2C8\uB294
      \uBAAC\uC2A4\uD130 \uB54C\uBB38\uC77C\uC138.\n\uC7A1\uC544\uB3C4 \uC7A1\uC544\uB3C4
      \uB05D\uC774 \uC5C6\uB2E4\uB124.."
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_03
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_04
    krText: "\uADF8 \uB188\uB4E4 \uC880 \uCC98\uCE58\uD574\uC8FC\uAC8C.\n\uC790\uB124\uB9CC
      \uBBFF\uACA0\uB124."
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_04
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_02_02
    krText: "\uC815\uB9D0 \uACE0\uB9D9\uB124."
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_02_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_03_02
    krText: "\uC774\uC820 \uADF8 \uB188\uB4E4 \uC218\uAC00 \uC880 \uC904\uC5C8\uACA0\uC9C0..\n\uC790\uB124\uB294
      \uC5ED\uC2DC \uBBFF\uACE0 \uB9E1\uAE38 \uC218 \uC788\uC5B4\uC11C \uC88B\uAD70."
    enText: KEY_TEXT_QUEST_GRAHAM_001_DIALOGUE_LINE_LIST_03_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_QUEST_NAME
    krText: "\uC131\uC7A5\uC744 \uC704\uD55C \uCCAB \uAC78\uC74C"
    enText: KEY_TEXT_QUEST_GRAHAM_002_QUEST_NAME
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DESCRIPTION
    krText: "\uCD0C\uC7A5\uC5D0\uAC8C \uC131\uC7A5\uC744 \uC704\uD55C \uAC00\uB974\uCE68\uC744
      \uBC1B\uC790."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DESCRIPTION
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_01
    krText: "\uADF8\uB798, \uC790\uB124\uC778\uAC00?\n\uBB34\uC2A8 \uC77C\uC778\uAC00?"
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_01
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_02
    krText: "\uC131\uC7A5\uC774\uB77C..\n\uC624\uB79C\uB9CC\uC5D0 \uC790\uB124\uC640
      \uAC19\uC740 \uC5F4\uC815\uC801\uC778 \uB208\uBE5B\uC744 \uBCF4\uB294\uAD70.."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_03
    krText: "\uC88B\uB124.\n\uBA3C\uC800, \uC774 \uC55E \uC232\uC73C\uB85C \uAC00\uC11C
      \uBAAC\uC2A4\uD130\uB97C \uBA87 \uB9C8\uB9AC \uCC98\uCE58\uD55C \uD6C4, \uC804\uB9AC\uD488\uC744
      \uAC00\uC838\uC624\uAC8C."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_03
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_04
    krText: "\uC131\uC7A5\uC5D4 \uC2E4\uC804\uACBD\uD5D8\uC774 \uAC00\uC7A5 \uC911\uC694\uD55C
      \uBC95.\n\uAC14\uB2E4\uC624\uAC8C."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_04
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_01_02
    krText: "\uC654\uB294\uAC00?\n\uC218\uACE0\uD588\uB124."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_01_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_02_02
    krText: "\uC5B4\uB5A4\uAC00, \uC2E4\uC81C\uB85C \uBAAC\uC2A4\uD130\uB97C \uC0C1\uB300\uD55C\uB2E4\uB294
      \uAC74 \uB9CC\uB9CC\uCE58 \uC54A\uC558\uC744\uD14C\uC9C0.\n\uD6C8\uB828\uC6A9
      \uBC00\uC9DA\uC778\uD615\uC73C\uB85C \uC5F0\uC2B5\uD558\uB358 \uAC83\uACFC\uB294
      \uB610 \uB2E4\uB978 \uB290\uB08C\uC774\uC600\uC744\uAC8C\uC57C."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_02_02
  - textKey: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_03_02
    krText: "\uC55E\uC73C\uB85C \uC815\uC9C4\uD558\uAC8C.\n\uC5F0\uC2B5\uACFC \uC2E4\uC804\uB9CC\uC774
      \uC790\uB124\uB97C \uB354 \uB192\uC740 \uACF3\uC73C\uB85C \uC131\uC7A5\uC2DC\uCF1C\uC904\uD14C\uB2C8."
    enText: KEY_TEXT_QUEST_GRAHAM_002_DIALOGUE_LINE_LIST_03_02
  - textKey: KEY_TEXT_SKILL_ARC_BOLT_SKILL_NAME
    krText: "\uC544\uD06C\uBCFC\uD2B8"
    enText: KEY_TEXT_SKILL_ARC_BOLT_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_ARC_BOLT_DESCRIPTION
    krText: "\uBC88\uAC1C\uC758 \uD798\uC774 \uAE43\uB4E0 \uC5D0\uB108\uC9C0 \uBCFC\uC744
      \uC804\uBC29\uC73C\uB85C \uBC1C\uC0AC\uD55C\uB2E4."
    enText: KEY_TEXT_SKILL_ARC_BOLT_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_BLIZARD_SKILL_NAME
    krText: "\uBE14\uB9AC\uC790\uB4DC"
    enText: KEY_TEXT_SKILL_BLIZARD_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_BLIZARD_DESCRIPTION
    krText: "\uD558\uB298\uAE38\uC744 \uC5F4\uC5B4 \uC5BC\uC74C \uACB0\uC815\uC744
      \uC218\uC5CE\uC774 \uC3DF\uC544\uBD87\uB294\uB2E4."
    enText: KEY_TEXT_SKILL_BLIZARD_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_DOUBLE_JUMP_SKILL_NAME
    krText: "\uB354\uBE14 \uC810\uD504"
    enText: KEY_TEXT_SKILL_DOUBLE_JUMP_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_DOUBLE_JUMP_DESCRIPTION
    krText: "\uC2E0\uC131\uD55C \uD798\uC744 \uC751\uCD95 \uC2DC\uD0A8 \uD6C4, \uC810\uD504
      \uD6C4 \uACF5\uC911\uC5D0\uC11C \uD55C \uBC88 \uB354 \uB3C4\uC57D\uD55C\uB2E4."
    enText: KEY_TEXT_SKILL_DOUBLE_JUMP_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_FLAME_SLASH_SKILL_NAME
    krText: "\uD50C\uB808\uC784 \uC2AC\uB798\uC2DC"
    enText: KEY_TEXT_SKILL_FLAME_SLASH_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_FLAME_SLASH_DESCRIPTION
    krText: "\uAC80\uB0A0\uC5D0 \uBD88\uAF43\uC744 \uC785\uD600 \uC804\uBC29\uC5D0
      \uD718\uB450\uB978\uB2E4."
    enText: KEY_TEXT_SKILL_FLAME_SLASH_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_MOON_BLADE_SKILL_NAME
    krText: "\uBB38 \uBE14\uB808\uC774\uB4DC"
    enText: KEY_TEXT_SKILL_MOON_BLADE_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_MOON_BLADE_DESCRIPTION
    krText: "\uB2EC\uBE5B\uC758 \uD798\uC744 \uC2E4\uC740 \uAC80\uAE30\uB97C \uC804\uBC29\uC73C\uB85C
      \uB0A0\uB9B0\uB2E4."
    enText: KEY_TEXT_SKILL_MOON_BLADE_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_SHADOW_PARTNER_SKILL_NAME
    krText: "\uC100\uB3C4\uC6B0 \uD30C\uD2B8\uB108"
    enText: KEY_TEXT_SKILL_SHADOW_PARTNER_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_SHADOW_PARTNER_DESCRIPTION
    krText: "\uC5B4\uB460\uC758 \uD798\uC744 \uADF8\uB9BC\uC790\uC5D0 \uAE43\uB4E4\uAC8C\uD55C\uB2E4.\n\uB098\uC758
      \uD589\uB3D9\uC744 \uBCF5\uC81C\uD558\uB294 \uADF8\uB9BC\uC790 \uBD84\uC2E0\uC744
      \uC0DD\uC131\uD55C\uB2E4."
    enText: KEY_TEXT_SKILL_SHADOW_PARTNER_DESCRIPTION
  - textKey: KEY_TEXT_SKILL_WIND_DANCE_SKILL_NAME
    krText: "\uC708\uB4DC \uB304\uC2A4"
    enText: KEY_TEXT_SKILL_WIND_DANCE_SKILL_NAME
  - textKey: KEY_TEXT_SKILL_WIND_DANCE_DESCRIPTION
    krText: "\uBC14\uB78C \uC18D\uC5D0 \uB179\uC544\uB4E4\uC5B4 \uC2DC\uC57C\uC5D0
      \uB4E4\uC5B4\uC628 \uBAA8\uB4E0 \uC801\uB4E4\uC744 \uBC88\uAC08\uC544 \uAC00\uBA70
      \uD0C0\uACA9\uD55C\uB2E4."
    enText: KEY_TEXT_SKILL_WIND_DANCE_DESCRIPTION
